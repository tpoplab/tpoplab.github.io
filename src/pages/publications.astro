---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PubItem from '../components/PubItem.astro';
import { LAB } from '../config';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const themes = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const inPress = pubs.filter((p) => p.data.status === 'in press');
const published = pubs.filter((p) => p.data.status === 'published');
const underReview = pubs.filter((p) => p.data.status === 'revise & resubmit');
const groups = [
  { label: 'In Press', items: inPress },
  ...[...new Set(published.map((p) => p.data.year))].map((y) => ({ label: String(y), items: published.filter((p) => p.data.year === y) })),
  { label: 'Revise & Resubmit', items: underReview },
].filter((g) => g.items.length);
---
<Base title="Publications" description="Peer-reviewed publications from T-Pop Research Lab.">
  <PageHero eyebrow="Publications" title="Selected publications" lede="Peer-reviewed articles and book chapters. Lab members are shown in bold.">
    {LAB.social.scholar && <p><a class="link-arrow" href={LAB.social.scholar}>Google Scholar profile</a></p>}
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="filters" role="group" aria-label="Filter by research theme">
        <button class="chip active" data-filter="all" aria-pressed="true">All</button>
        {themes.map((t) => (
          <button class="chip" data-filter={t.id} aria-pressed="false">{t.data.short}</button>
        ))}
      </div>

      {groups.map((g) => (
        <div class="year-group">
          <h2 class:list={['year', { word: isNaN(Number(g.label)) }]}>{g.label}</h2>
          <div>
            {g.items.map((p) => (
              <div class="pub-wrap" data-themes={p.data.themes.join(' ')}><PubItem pub={p} showYear={false} /></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  function apply(f: string) {
    chips.forEach((c) => {
      const on = c.dataset.filter === f;
      c.classList.toggle('active', on);
      c.setAttribute('aria-pressed', String(on));
    });
    document.querySelectorAll<HTMLElement>('.pub-wrap').forEach((el) => {
      el.hidden = f !== 'all' && !(el.dataset.themes ?? '').split(' ').includes(f);
    });
    document.querySelectorAll<HTMLElement>('.year-group').forEach((g) => {
      g.hidden = !g.querySelector('.pub-wrap:not([hidden])');
    });
  }
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter ?? 'all';
      apply(f);
      history.replaceState(null, '', f === 'all' ? location.pathname : `?theme=${f}`);
    })
  );
  // Support links like /publications?theme=aging from the Research page
  const initial = new URLSearchParams(location.search).get('theme');
  if (initial && document.querySelector(`.chip[data-filter="${CSS.escape(initial)}"]`)) apply(initial);
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem; position: sticky; top: 4.25rem; z-index: 5; padding-block: 0.75rem; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); }
  .chip {
    font: inherit; font-size: 0.9rem; font-weight: 500; cursor: pointer;
    padding: 0.45rem 1rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink-soft);
    transition: all 0.15s;
  }
  .chip span { color: var(--ink-faint); margin-left: 0.25rem; font-variant-numeric: tabular-nums; }
  .chip:hover { border-color: var(--ink-faint); }
  .chip.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .chip.active span { color: inherit; opacity: 0.6; }
  .year-group { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; margin-bottom: 1.5rem; }
  .year { font-size: 2.25rem; font-weight: 300; color: var(--accent); position: sticky; top: 9rem; align-self: start; padding-top: 1.2rem; }
  .year.word { font-size: 1.35rem; font-weight: 400; line-height: 1.25; }
  @media (max-width: 700px) {
    .year-group { grid-template-columns: 1fr; gap: 0; }
    .year { position: static; }
    .filters { position: static; }
  }
</style>
