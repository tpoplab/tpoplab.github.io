---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { LAB } from '../config';

// Optional: paste a Google Maps "Embed a map" URL here to show a map ('' hides it)
const mapEmbedUrl = 'https://www.google.com/maps?q=National+Chengchi+University+Department+of+Sociology&output=embed';
---
<Base title="Contact" description="How to reach and visit the lab.">
  <PageHero eyebrow="Contact" title="Get in touch" lede="Questions about our research, collaboration, or joining the lab? We would be glad to hear from you." />

  <section class="section">
    <div class="container contact">
      <div class="card">
        <h3>Email</h3>
        <p><a href={`mailto:${LAB.email}`}>{LAB.email}</a></p>
      </div>
      <div class="card">
        <h3>Visit</h3>
        <address>{LAB.address.map((l) => <>{l}<br /></>)}</address>
      </div>
      <div class="card">
        <h3>Affiliation</h3>
        <p>{LAB.fullName}<br />{LAB.institution}</p>
      </div>
    </div>
    {mapEmbedUrl && (
      <div class="container map">
        <iframe src={mapEmbedUrl} title="Map to the lab" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    )}
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.5rem; }
  .contact p, address { margin: 0; color: var(--ink-soft); font-style: normal; }
  .map { margin-top: 2rem; }
  .map iframe { width: 100%; height: 400px; border: 1px solid var(--line); border-radius: var(--radius); }
</style>
