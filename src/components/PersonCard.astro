---
import type { CollectionEntry } from 'astro:content';
import { initials, url } from '../utils';

interface Props { person: CollectionEntry<'people'>; compact?: boolean }
const { person, compact = false } = Astro.props;
const p = person.data;
---
<article class:list={['person', { compact }]}>
  <div class="photo">
    {p.photo
      ? <img src={url(p.photo)} alt={`Photo of ${p.name}`} loading="lazy" />
      : <span class="initials">{initials(p.name)}</span>}
  </div>
  <div class="info">
    <h3>{p.name}</h3>
    <p class="role">{p.title ?? p.role}</p>
    {p.now && <p class="now">Now: {p.now}</p>}
    {!compact && p.interests.length > 0 && (
      <ul class="interests">{p.interests.map((i) => <li>{i}</li>)}</ul>
    )}
    {!compact && (p.email || p.website) && (
      <p class="links">
        {p.email && <a href={`mailto:${p.email}`}>Email</a>}
        {p.website && <a href={p.website}>Website</a>}
      </p>
    )}
  </div>
</article>

<style>
  .person { display: flex; flex-direction: column; gap: 1.1rem; }
  .photo {
    aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden;
    background: linear-gradient(145deg, var(--accent-soft), var(--bg-soft));
    border: 1px solid var(--line);
    display: grid; place-items: center;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .person:hover .photo img { transform: scale(1.03); }
  .initials { font-family: var(--font-serif); font-size: 2.6rem; color: var(--accent); opacity: 0.8; }
  h3 { margin: 0 0 0.15rem; font-size: 1.2rem; }
  .role { color: var(--ink-soft); font-size: 0.92rem; margin: 0; }
  .now { color: var(--ink-faint); font-size: 0.88rem; margin: 0.2rem 0 0; }
  .interests { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .interests li { font-size: 0.78rem; padding: 0.15rem 0.55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-soft); }
  .links { display: flex; gap: 1rem; margin: 0.75rem 0 0; font-size: 0.9rem; font-weight: 500; }

  .compact { flex-direction: row; align-items: center; gap: 0.9rem; }
  .compact .photo { width: 3.5rem; aspect-ratio: 1; border-radius: 50%; flex: none; }
  .compact .initials { font-size: 1.1rem; }
  .compact h3 { font-size: 1.02rem; font-family: var(--font-sans); font-weight: 600; letter-spacing: 0; }
</style>
