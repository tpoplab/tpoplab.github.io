---
// Decorative population pyramid for the homepage hero.
// The bar widths are illustrative (an aging, "constrictive" shape), not real data.
const bands = [0.34, 0.44, 0.5, 0.56, 0.64, 0.72, 0.8, 0.88, 0.96, 1, 0.98, 0.92, 0.84, 0.7, 0.62, 0.66, 0.68, 0.62];
const bandsF = bands.map((w, i) => Math.min(1, w + (i < 4 ? 0.08 : 0) + (i < 9 ? 0 : 0.02)));
const H = 400, W = 400, mid = W / 2, gap = 6, bar = 15, step = 21, maxHalf = 170;
const top = (H - bands.length * step) / 2;
---
<svg viewBox={`0 0 ${W} ${H}`} class="pyramid" aria-hidden="true">
  <line x1={mid} y1={top - 14} x2={mid} y2={H - top + 8} class="axis" />
  {bands.map((_, idx) => {
    // idx 0 = oldest band at the top
    const y = top + idx * step;
    const wl = bands[idx] * maxHalf;
    const wr = bandsF[idx] * maxHalf;
    const delay = `${(bands.length - idx) * 45}ms`;
    return (
      <g style={`--d:${delay}`}>
        <rect x={mid - gap / 2 - wl} y={y} width={wl} height={bar} rx="7.5" class:list={['bar', 'left', { hi: idx === 0 || idx === 1 }]} />
        <rect x={mid + gap / 2} y={y} width={wr} height={bar} rx="7.5" class:list={['bar', 'right', { hi: idx === 0 || idx === 1 }]} />
      </g>
    );
  })}
  <text x={mid - 12} y={H - top + 26} text-anchor="end" class="lbl">Men</text>
  <text x={mid + 12} y={H - top + 26} class="lbl">Women</text>
  <text x={W - 6} y={top + 11} text-anchor="end" class="lbl small">older</text>
  <text x={W - 6} y={H - top - 4} text-anchor="end" class="lbl small">younger</text>
</svg>

<style>
  .pyramid { width: 100%; max-width: 440px; display: block; margin-left: auto; overflow: visible; }
  .axis { stroke: var(--line); stroke-width: 1; }
  .bar.left { fill: var(--accent); opacity: 0.85; }
  .bar.right { fill: color-mix(in srgb, var(--accent) 45%, var(--bg)); }
  .bar.hi { fill: var(--highlight); opacity: 1; }
  .lbl { font: 600 11px var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; fill: var(--ink-faint); }
  .small { font-size: 10px; font-weight: 500; }
  @media (prefers-reduced-motion: no-preference) {
    .bar { transform-box: fill-box; animation: grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: var(--d); }
    .bar.left { transform-origin: right center; }
    .bar.right { transform-origin: left center; }
    @keyframes grow { from { transform: scaleX(0); } }
  }
</style>
