---
// The lab's mark: a stylized population pyramid. Replace with your own logo SVG any time.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--accent)" />
  <rect x="12.5" y="6.5" width="7" height="3" rx="1.5" fill="var(--highlight)" />
  <rect x="9.5" y="11" width="13" height="3" rx="1.5" fill="var(--bg)" />
  <rect x="7" y="15.5" width="18" height="3" rx="1.5" fill="var(--bg)" />
  <rect x="8.5" y="20" width="15" height="3" rx="1.5" fill="var(--bg)" opacity="0.75" />
  <rect x="11" y="24.5" width="10" height="3" rx="1.5" fill="var(--bg)" opacity="0.5" />
</svg>
