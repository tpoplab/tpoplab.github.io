---
// Decorative life-course illustration for the homepage hero:
// trajectories that start close together in childhood and fan out with age
// (cumulative advantage and disadvantage). Illustrative, not real data.
const x0 = 40, x1 = 370, y0 = 262, baseY = 330;
const curve = (k: number) => ({
  p0: [x0, y0 + k * 3], c1: [150, y0 + k * 6], c2: [250, 200 + k * 30], p1: [x1, 196 + k * 38],
});
const toD = (c: ReturnType<typeof curve>) => `M${c.p0} C${c.c1} ${c.c2} ${c.p1}`;
const bez = (t: number, a: number, b: number, c: number, d: number) =>
  (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * b + 3 * (1 - t) * t ** 2 * c + t ** 3 * d;
// y of a curve at a given x (binary search on t)
const yAt = (c: ReturnType<typeof curve>, x: number) => {
  let lo = 0, hi = 1;
  for (let i = 0; i < 40; i++) {
    const m = (lo + hi) / 2;
    bez(m, c.p0[0], c.c1[0], c.c2[0], c.p1[0]) < x ? (lo = m) : (hi = m);
  }
  return bez(lo, c.p0[1], c.c1[1], c.c2[1], c.p1[1]);
};

const ks = [-3, -2, 0, 1, 2, 3];
const main = curve(-1);
// Shaded band between the highest and lowest trajectories: the widening gap
const hi = curve(-3), lo = curve(3);
const band = `M${hi.p0} C${hi.c1} ${hi.c2} ${hi.p1} L${lo.p1} C${lo.c2} ${lo.c1} ${lo.p0} Z`;
const stages = [
  { label: 'Childhood', from: x0, to: 112 },
  { label: 'Adolescence', from: 112, to: 182 },
  { label: 'Adulthood', from: 182, to: 284 },
  { label: 'Later life', from: 284, to: x1 },
];
const markers = [75, 147, 233, 330].map((x) => ({ x, y: yAt(main, x) }));
---
<svg viewBox="0 0 400 400" class="lifecourse" aria-hidden="true">
  {stages.slice(1).map((s) => <line x1={s.from} y1="70" x2={s.from} y2={baseY} class="divider" />)}
  <line x1={x0} y1={baseY} x2={x1 + 12} y2={baseY} class="axis" />
  <path d={`M${x1 + 6},${baseY - 4} L${x1 + 12},${baseY} L${x1 + 6},${baseY + 4}`} class="axis" />
  <text x={x1 + 12} y={baseY + 36} text-anchor="end" class="lbl small">Age</text>

  <path d={band} class="band" />
  {ks.map((k, i) => (
    <path d={toD(curve(k))} pathLength="1" class="traj" style={`--d:${i * 90}ms; --o:${0.22 + (3 - Math.abs(k)) * 0.07}`} />
  ))}
  <path d={toD(main)} pathLength="1" class="traj main" style="--d:200ms" />

  {markers.map((m, i) => (
    <g class="marker" style={`--d:${900 + i * 180}ms`}>
      <circle cx={m.x} cy={m.y} r="9" class="halo" />
      <circle cx={m.x} cy={m.y} r={4 + i * 0.6} class:list={['dot', { last: i === markers.length - 1 }]} />
    </g>
  ))}

  {stages.map((s) => <text x={(s.from + s.to) / 2} y={baseY + 18} text-anchor="middle" class="lbl">{s.label}</text>)}
</svg>

<style>
  .lifecourse { width: 100%; max-width: 440px; display: block; margin-left: auto; overflow: visible; }
  .divider { stroke: var(--line); stroke-dasharray: 2 5; }
  .axis { stroke: var(--ink-faint); stroke-width: 1.2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .band { fill: var(--accent); opacity: 0.07; }
  .traj { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; opacity: var(--o); }
  .traj.main { stroke-width: 3.5; opacity: 1; }
  .halo { fill: var(--accent); opacity: 0.12; }
  .dot { fill: var(--bg); stroke: var(--accent); stroke-width: 2.5; }
  .dot.last { fill: var(--highlight); stroke: var(--highlight); }
  .lbl { font: 500 11px var(--font-sans); fill: var(--ink-soft); }
  .small { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--ink-faint); font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .traj { stroke-dasharray: 1; animation: draw 1.6s cubic-bezier(0.3, 0.6, 0.2, 1) both; animation-delay: var(--d); }
    .band { animation: fade 1.2s ease-out 0.6s both; }
    @keyframes fade { from { opacity: 0; } }
    .marker { animation: pop 0.5s ease-out both; animation-delay: var(--d); transform-box: fill-box; transform-origin: center; }
    @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes pop { from { opacity: 0; transform: scale(0.4); } }
  }
</style>
